{
  "name": "songsterr-to-sheet-music",
  "version": "1.0.0",
  "description": "Turn Songsterr tabs into printable sheet music: standard notation, tablature, or both.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/bundle-transcriber.js && node server.js",
    "bundle-transcriber": "node scripts/bundle-transcriber.js",
    "build": "node scripts/build-static.js",
    "fetch-sounds": "node scripts/fetch-sounds.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs-backend-wasm": "^3.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
